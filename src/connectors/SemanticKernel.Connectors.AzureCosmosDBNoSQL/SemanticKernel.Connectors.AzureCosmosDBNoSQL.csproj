<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AIToolbox.SemanticKernel.Connectors.Memory.AzureCosmosDBNoSQL</AssemblyName>
    <RootNamespace>AIToolbox.SemanticKernel.Memory</RootNamespace>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0020</NoWarn>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureCosmosDBNoSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticKernel.DependencyInjection\SemanticKernel.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIToolbox.DependencyInjection.UnitTests" />
  </ItemGroup>

  <Import Project="$(RepoRoot)/nuget/NuGet.Package.props" />

  <PropertyGroup>
    <!-- NuGet Package Settings -->
    <Title>AI Toolbox - Semantic Kernel's Azure Cosmos DB for NoSQL connector</Title>
    <Description>Semantic Kernel's Azure Cosmos DB for NoSQL connector for AI Toolbox.</Description>
  </PropertyGroup>

</Project>
