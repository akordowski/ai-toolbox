  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.DuckDB" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticKernel.DependencyInjection\SemanticKernel.DependencyInjection.csproj" />
