<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AIToolbox.SemanticKernel</AssemblyName>
    <RootNamespace>AIToolbox.SemanticKernel</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <NoWarn>$(NoWarn)</NoWarn>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AIToolbox.Abstractions\AIToolbox.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIToolbox.SemanticKernel.DependencyInjection" />
    <InternalsVisibleTo Include="SemanticKernel.UnitTests" />
  </ItemGroup>

  <Import Project="$(RepoRoot)/nuget/NuGet.Package.props" />

  <PropertyGroup>
    <!-- NuGet Package Settings -->
    <Title>AI Toolbox - Semantic Kernel</Title>
    <Description>Semantic Kernel for AI Toolbox.</Description>
  </PropertyGroup>

</Project>
